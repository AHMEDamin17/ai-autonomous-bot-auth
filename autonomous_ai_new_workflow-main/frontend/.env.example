# Frontend Environment Variables
# Copy this file to .env and fill in the values

# URL of the backend API server
VITE_BACKEND_URL=http://localhost:3005

# Must match backend API_KEY. This value is bundled into the frontend, so the
# current API-key scheme is suitable for trusted/internal deployments only.
VITE_API_KEY=default-dev-key

# Microsoft Entra ID (Azure AD) SPA settings — public IDs only; never put a
# client secret in Vite env. Values must match the backend Entra configuration.
VITE_AZURE_ENTRA_ENABLED=true
VITE_AZURE_ENTRA_TENANT_ID=
VITE_AZURE_ENTRA_CLIENT_ID=
# Primary authority. If blank, built as https://login.microsoftonline.com/{TENANT_ID}
VITE_AZURE_ENTRA_AUTHORITY=
VITE_AZURE_ENTRA_REDIRECT_URI=http://localhost:5173
# Must match an SPA redirect URI in Entra exactly (including trailing slash).
# For full-page loginRedirect use the SPA origin, e.g. http://localhost:5173
# Access-token scope for the API (e.g. api://{clientId}/access_as_user).
# Falls back to openid profile email when blank.
VITE_AZURE_ENTRA_API_SCOPE=

# Note: AI Models are now configured on the Backend side (.env in the backend folder)
# using GROQ_API_KEY or LLM_BASE_URL.

# Observability Dashboard Limits
VITE_OBSERVABILITY_POLLING_INTERVAL_MS=5000
VITE_OBSERVABILITY_LOG_LIMIT=50
