{
  "name": "icon-component-backend",
  "version": "1.0.0",
  "description": "Express TypeScript backend for Icon Component",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/main.ts",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc --project tsconfig.json",
    "start": "cross-env PORT=3005 node dist/main.js",
    "test": "tsx src/sql/compiler.ts --selftest && tsx src/tests/regression.test.ts --selftest",
    "migrate": "tsx scripts/migrate.ts",
    "verify:schema": "tsx scripts/verifyCurrentSchema.ts",
    "test:schema": "tsx scripts/schemaBaselineSelftest.ts",
    "test:auth": "tsx scripts/authSelftest.ts",
    "test:vector": "tsx scripts/vectorSelftest.ts",
    "test:model-store": "tsx scripts/modelStoreSelftest.ts",
    "test:semantic-generator": "tsx scripts/semanticGeneratorSelftest.ts",
    "test:semantic-api": "tsx scripts/semanticApiSelftest.ts",
    "test:semantic-key": "tsx scripts/semanticKeySelftest.ts",
    "test:implementation": "npm.cmd run test:schema && npm.cmd run test:auth && npm.cmd run test:semantic-key && npm.cmd run test:vector && npm.cmd run test:model-store && npm.cmd run test:semantic-generator && npm.cmd run test:semantic-api && npm.cmd run verify:schema"
  },
  "dependencies": {
    "@databricks/sql": "^1.16.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@langchain/core": "^0.3.0",
    "@langchain/groq": "^0.1.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.8",
    "langchain": "^0.3.0",
    "mongodb": "^6.5.0",
    "mssql": "^12.5.5",
    "mysql2": "^3.9.8",
    "pg": "^8.11.3",
    "redis": "^6.0.0",
    "snowflake-sdk": "^3.0.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.2",
    "@types/sqlite3": "^3.1.11",
    "eslint-plugin-security": "^4.0.1",
    "nodemon": "^3.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.2"
  },
  "overrides": {
    "@langchain/core": "^0.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
