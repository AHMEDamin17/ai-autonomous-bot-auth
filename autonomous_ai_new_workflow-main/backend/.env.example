# =============================================================================
# Backend environment template
# =============================================================================
# Copy this file to .env, fill in secrets, and restart the backend after changes.
# Backend nodemon watches source files only; it does not restart for .env changes.

# =============================================================================
# 1. Server, authentication, and deployment identity
# =============================================================================
PORT=3005
PUBLIC_API_BASE_URL=
API_KEY=default-dev-key
CORS_ORIGIN=http://localhost:5173

SESSION_COOKIE_NAME=ai_session
SESSION_TTL_HOURS=8

# Microsoft Entra ID (Azure AD) — user sign-in. Authority is the primary source;
# if blank, the backend builds https://login.microsoftonline.com/{TENANT_ID}.
AZURE_ENTRA_ENABLED=true
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_AUTHORITY=
# Expected JWT audience (often the client ID or api://{clientId})
AZURE_ENTRA_AUDIENCE=
# Role assigned to newly provisioned Entra users when at least one admin exists.
AZURE_ENTRA_DEFAULT_ROLE=user

# Required for encrypting saved connection credentials.
# Use a long random value in real deployments and do not rotate it casually.
CONNECTION_SECRET_KEY=replace-with-a-long-random-secret

# Separates deployment-scoped Redis keys and other environment-specific state.
DEPLOYMENT_ID=local-dev

# =============================================================================
# 2. Metadata database and SQL runtime defaults
# =============================================================================
# Stores saved connections, semantic models, KPI metrics, and telemetry.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=autonomous_db

# SSL behavior for supported MySQL/PostgreSQL connections.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# SQLite analytics files must remain inside this directory.
SQLITE_DATA_DIR=./data

# Ambiguous numeric dates are interpreted in this order: MDY | DMY | YMD.
DATE_INPUT_ORDER=MDY

# =============================================================================
# 3. Language-model provider and shared request limits
# =============================================================================
# Active provider: groq | openrouter | nvidia | openai
# Only the model settings for the active provider are used.
LLM_PROVIDER=groq
LLM_MAX_COMPLETION_TOKENS=1024
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT_ENABLED=true
LLM_MAX_CONCURRENT=1
LLM_MAX_QUEUE_SIZE=100
LLM_MAX_QUEUE_WAIT_MS=60000
LLM_RATE_LIMIT_MAX_RETRIES=2
LLM_RATE_LIMIT_RETRY_BASE_MS=2000
LLM_RATE_LIMIT_RETRY_MAX_MS=60000
# Measurement is always collected in the bounded telemetry buffer. Set this to
# true only when the company permits token/context values in Observability APIs,
# live exports, SSE, and the frontend tab.
SHOW_LLM_TOKEN_USAGE=false
# Override with <PROVIDER>_CONTEXT_WINDOW_TOKENS when provider models differ.
LLM_CONTEXT_WINDOW_TOKENS=128000

# --- Groq --------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MIN_INTERVAL_MS=12000

# --- OpenRouter (standby/fallback provider) ------------------------------------
# Create a key at https://openrouter.ai/settings/keys, set LLM_PROVIDER to
# openrouter, and restart the backend. Free model IDs rotate frequently -- check
# https://openrouter.ai/api/v1/models and prefer one whose /endpoints response
# shows a healthy status and structured_outputs: true before assuming the value
# below is still live.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MIN_INTERVAL_MS=3200
OPENROUTER_MAX_CONCURRENT=1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE="Autonomous AI Analytics"

# --- NVIDIA NIM ---------------------------------------------------------------
# Create a key and browse models at https://build.nvidia.com. Planning requires a
# model that supports tool calls and structured output.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MIN_INTERVAL_MS=2500
NVIDIA_MAX_CONCURRENT=1
NVIDIA_TIMEOUT_MS=60000

# --- Custom OpenAI-compatible endpoint ---------------------------------------
# Set LLM_PROVIDER=openai and configure these for Ollama, vLLM, LM Studio, or
# another OpenAI-compatible endpoint.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=sk-local-dev
# LLM_MODEL=llama3.1:8b

# --- Semantic model generation (Semantic Model tab) --------------------------
# A connection's schema is modelled by the LLM in BATCHES so no single request
# exceeds the provider's tokens-per-minute limit. Tune these to your provider's
# limit (e.g. Groq free tier is ~12000 TPM, so keep input + output well below it).
#
# SEMANTIC_GEN_BATCH_TOKENS = INPUT budget: max estimated schema tokens sent per
#   LLM call. Tables are grouped into batches under this size (a single oversized
#   table still goes alone). Lower it for stricter limits / very wide tables.
SEMANTIC_GEN_BATCH_TOKENS=3000
# SEMANTIC_GEN_MAX_TOKENS = OUTPUT budget: max completion tokens per batch call.
# Keep SEMANTIC_GEN_BATCH_TOKENS + SEMANTIC_GEN_MAX_TOKENS comfortably under the
# provider's per-minute token limit to avoid "request too large" (413) errors.
SEMANTIC_GEN_MAX_TOKENS=4096
# Per-call request timeout for generation (ms).
SEMANTIC_GEN_TIMEOUT_MS=120000
# Explicit large-document cap for semantic-model API requests (10 MiB).
SEMANTIC_MODEL_MAX_BODY_BYTES=10485760
# Hard bounds for application-aware generation.
SEMANTIC_GEN_MAX_TABLES=100
SEMANTIC_GEN_MAX_CALLS=150
SEMANTIC_GEN_WIDE_TABLE_CHUNK_COLUMNS=60
# Per-connection generation lease; stale jobs become recoverable errors.
SEMANTIC_GENERATION_LEASE_MS=900000

# --- Local semantic-vector index (Qdrant + Ollama) ---------------------------
# The local Docker stack binds both services only to localhost and requires no
# sign-in. MySQL remains authoritative; Qdrant is a rebuildable derived index.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=semantic_models
QDRANT_TIMEOUT_MS=10000
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_MODEL=nomic-embed-text:v1.5
EMBEDDINGS_DIM=768
EMBEDDINGS_TIMEOUT_MS=30000

# =============================================================================
# 4. Analytics orchestration
# =============================================================================
# ANALYTICS_ORCHESTRATOR_MODE chooses WHO advances the guarded workflow. Every
# question still has a mandatory LLM semantic entry in both modes. The modes
# run the same validation, compiler, execution, and response protections;
# assembly — only the tool-ordering decision differs:
#   deterministic (default): the LLM planner runs first, then backend code
#     follows each tool's `next` pointer. A clean request normally spends one
#     LLM call. Fast, quota-efficient, predictable.
#   agent: a LangGraph ReAct agent (an LLM) decides which tool to call next each
#     turn (~1 LLM call per tool, ~8 per request) — more autonomous but slower
#     and ~5-8x more provider quota.
# Model selection happens only in section 3 through LLM_PROVIDER and that
# provider's model setting; both modes and the planners reuse that one model.
# Any other mode value is rejected as a configuration error.
ANALYTICS_ORCHESTRATOR_MODE=deterministic

# Safety and bounded recovery (both modes; recursion limit bounds the agent loop).
ANALYTICS_ORCHESTRATOR_RECURSION_LIMIT=30
ANALYTICS_ORCHESTRATOR_MAX_TOOL_CALLS=18
ANALYTICS_PLANNER_MAX_ATTEMPTS=3
ANALYTICS_DB_MAX_ATTEMPTS=2

# Column pruning for the Simple planner catalog. A table with at least
# ANALYTICS_CATALOG_PRUNE_THRESHOLD columns is trimmed to
# ANALYTICS_CATALOG_PRUNE_MAX_COLUMNS (keeping PKs, KPI-referenced,
# question-overlapping, and entity-display columns). Safe defaults (60/40) prune
# wide tables so the planner prompt stays within the provider's tokens-per-minute
# limit; lower further (e.g. 40/40) for very wide schemas, or raise on a
# large-context/paid model.
ANALYTICS_CATALOG_PRUNE_THRESHOLD=60
ANALYTICS_CATALOG_PRUNE_MAX_COLUMNS=40

# =============================================================================
# 5. Resilience, query limits, and telemetry
# =============================================================================
CIRCUIT_FAILURE_THRESHOLD=2
CIRCUIT_SUCCESS_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=15000
CIRCUIT_DECAY_MS=60000

MAX_QUERY_LIMIT=100
MAX_CONVERSATIONS=10
RESULT_CACHE_MAX_ENTRIES=500
MAX_TELEMETRY_LOGS=500
LATENCY_SAMPLE_RATE=0.05

# Optional Redis-backed circuit breaker/result cache. Blank uses in-memory state.
REDIS_URL=
